# Free Portfolio Mode. Keep APP_SECRET_KEY blank in Git and inject a generated
# value through the shell or a local, ignored .env file. Local PostgreSQL uses
# trust authentication and does not require a database password.
APP_ENV=local
DEPLOYMENT_PROFILE=free-portfolio
APP_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://foundation@postgres:5432/foundation
APP_SECRET_KEY=
CONTRACT_VERSION=v1
PAYMENT_PROVIDER=mock
MOCK_PAYMENTS_ENABLED=true
PAYMENT_SANDBOX=true
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
TOSS_SUCCESS_URL=http://localhost:3000/payments/toss/success
TOSS_BILLING_SUCCESS_URL=http://localhost:3000/payments/toss/billing-success
TOSS_FAIL_URL=http://localhost:3000/payments/toss/fail
AUTH_PROVIDER=local-mock
AGENT_PROVIDER=local
AGENT_MODEL=local-echo
AGENT_MAX_OUTPUT_TOKENS=512
AGENT_TIMEOUT_SECONDS=30
WORKFLOW_PROVIDER=local
PAID_INFRASTRUCTURE=false
AWS_WORKER_ENABLED=false
VERCEL_PLAN=free
CLOUDFLARE_PLAN=free
RUN_QUOTA_MAX_RUNS=10
RUN_QUOTA_MAX_UNITS=100
RUN_QUOTA_PERIOD_SECONDS=86400
OTEL_ENABLED=true
OTEL_SAMPLE_RATE=0.1
OTEL_EXPORTER=memory

# FAQ routing is opt-in; exact/alias matches never call a provider.
# FAQ_PROVIDER selects the router: unset or anything other than "jev" uses
# OpenAI (default, unchanged); FAQ_PROVIDER=jev switches to the Jev adapter,
# which is itself inert until JEV_API_KEY is set.
FAQ_PROVIDER=openai
FAQ_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-4o-mini

# Jev (TypeSafe) FAQ router — config-flagged alternative, defaults off.
# Requires FAQ_PROVIDER=jev to be selected; inert without JEV_API_KEY.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000
