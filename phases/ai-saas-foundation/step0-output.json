acts.ai-saas.local/rest/v1/health.json\",\n+  \"version\": \"v1\",\n+  \"title\": \"Health response\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"required\": [\"status\", \"contract_version\", \"deployment_profile\"],\n+  \"properties\": {\n+    \"status\": {\"type\": \"string\", \"enum\": [\"ok\"]},\n+    \"contract_version\": {\"const\": \"v1\"},\n+    \"deployment_profile\": {\"type\": \"string\", \"enum\": [\"free-portfolio\", \"aws-worker\"]}\n+  },\n+  \"x-example\": {\"status\": \"ok\", \"contract_version\": \"v1\", \"deployment_profile\": \"free-portfolio\"}\n+}\ndiff --git a/packages/contracts/rest/v1/run-create.json b/packages/contracts/rest/v1/run-create.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..c2c2ea31feb67c6c85b3cef5bc551a9c353dfdd6\n--- /dev/null\n+++ b/packages/contracts/rest/v1/run-create.json\n@@ -0,0 +1,24 @@\n+{\n+  \"$id\": \"https://contracts.ai-saas.local/rest/v1/run-create.json\",\n+  \"version\": \"v1\",\n+  \"title\": \"Create run request\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"required\": [\"contract_version\", \"tenant_id\", \"project_id\", \"idempotency_key\", \"trace_id\", \"input\"],\n+  \"properties\": {\n+    \"contract_version\": {\"const\": \"v1\"},\n+    \"tenant_id\": {\"type\": \"string\", \"minLength\": 1},\n+    \"project_id\": {\"type\": \"string\", \"minLength\": 1},\n+    \"idempotency_key\": {\"type\": \"string\", \"minLength\": 8},\n+    \"trace_id\": {\"type\": \"string\", \"minLength\": 8},\n+    \"input\": {\"type\": \"object\", \"additionalProperties\": true}\n+  },\n+  \"x-example\": {\n+    \"contract_version\": \"v1\",\n+    \"tenant_id\": \"tenant-demo\",\n+    \"project_id\": \"project-demo\",\n+    \"idempotency_key\": \"run-request-001\",\n+    \"trace_id\": \"trace-001\",\n+    \"input\": {\"message\": \"contract fixture\"}\n+  }\n+}\ndiff --git a/packages/contracts/rest/v1/run-status.json b/packages/contracts/rest/v1/run-status.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..6e374eb5f400b113feec7943dc05fd1360122382\n--- /dev/null\n+++ b/packages/contracts/rest/v1/run-status.json\n@@ -0,0 +1,22 @@\n+{\n+  \"$id\": \"https://contracts.ai-saas.local/rest/v1/run-status.json\",\n+  \"version\": \"v1\",\n+  \"title\": \"Run status response\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"required\": [\"contract_version\", \"run_id\", \"tenant_id\", \"state\", \"sequence\"],\n+  \"properties\": {\n+    \"contract_version\": {\"const\": \"v1\"},\n+    \"run_id\": {\"type\": \"string\", \"minLength\": 1},\n+    \"tenant_id\": {\"type\": \"string\", \"minLength\": 1},\n+    \"state\": {\"type\": \"string\", \"enum\": [\"queued\", \"running\", \"waiting_approval\", \"completed\", \"failed\", \"cancelled\"]},\n+    \"sequence\": {\"type\": \"integer\"}\n+  },\n+  \"x-example\": {\n+    \"contract_version\": \"v1\",\n+    \"run_id\": \"run-demo\",\n+    \"tenant_id\": \"tenant-demo\",\n+    \"state\": \"queued\",\n+    \"sequence\": 1\n+  }\n+}\ndiff --git a/packages/contracts/sse/v1/run-event.json b/packages/contracts/sse/v1/run-event.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..af0b2f88aca61e0094463cf82a14baa625a98ce7\n--- /dev/null\n+++ b/packages/contracts/sse/v1/run-event.json\n@@ -0,0 +1,24 @@\n+{\n+  \"$id\": \"https://contracts.ai-saas.local/sse/v1/run-event.json\",\n+  \"version\": \"v1\",\n+  \"title\": \"Replayable run SSE event\",\n+  \"type\": \"object\",\n+  \"additionalProperties\": false,\n+  \"required\": [\"contract_version\", \"event_id\", \"event\", \"run_id\", \"sequence\", \"payload\"],\n+  \"properties\": {\n+    \"contract_version\": {\"const\": \"v1\"},\n+    \"event_id\": {\"type\": \"string\", \"minLength\": 1},\n+    \"event\": {\"type\": \"string\", \"enum\": [\"run.state_changed\", \"run.token\", \"run.completed\", \"run.failed\"]},\n+    \"run_id\": {\"type\": \"string\", \"minLength\": 1},\n+    \"sequence\": {\"type\": \"integer\"},\n+    \"payload\": {\"type\": \"object\", \"additionalProperties\": true}\n+  },\n+  \"x-example\": {\n+    \"contract_version\": \"v1\",\n+    \"event_id\": \"run-event-001\",\n+    \"event\": \"run.state_changed\",\n+    \"run_id\": \"run-demo\",\n+    \"sequence\": 1,\n+    \"payload\": {\"state\": \"queued\"}\n+  }\n+}\ndiff --git a/scripts/start-local.sh b/scripts/start-local.sh\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..f072b4fed3293e56c9216a6b465aaae26c8d7c77\n--- /dev/null\n+++ b/scripts/start-local.sh\n@@ -0,0 +1,6 @@\n+#!/usr/bin/env sh\n+set -eu\n+\n+env_file=${1:-config/profiles/free-portfolio.example.env}\n+profile=${DEPLOYMENT_PROFILE:-free-portfolio}\n+exec python3 -m foundation.server --env-file \"$env_file\" --profile \"$profile\" --host \"${HOST:-127.0.0.1}\" --port \"${PORT:-8080}\"\ndiff --git a/services/admin-operations/README.md b/services/admin-operations/README.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..07d941d679f8b6bc7d27b4b6f732cfa242f0100e\n--- /dev/null\n+++ b/services/admin-operations/README.md\n@@ -0,0 +1,4 @@\n+# admin-operations\n+\n+Owns privileged use cases and append-only audit records. Mutations require\n+server-side authorization, target scope, reason, and idempotency.\ndiff --git a/services/agent-worker/README.md b/services/agent-worker/README.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..57f0d06b79da27af9c437b5ab5d06b611cbc09e9\n--- /dev/null\n+++ b/services/agent-worker/README.md\n@@ -0,0 +1,4 @@\n+# agent-worker\n+\n+Owns bounded execution and checkpoints. The optional AWS profile is an\n+interruptible worker-only boundary with no inbound route.\ndiff --git a/services/identity-tenant/README.md b/services/identity-tenant/README.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..eb070aa1b316452d00a4e754630fd8d0d795ebbe\n--- /dev/null\n+++ b/services/identity-tenant/README.md\n@@ -0,0 +1,4 @@\n+# identity-tenant\n+\n+Owns users, organizations, memberships, RBAC, and OAuth/session policy. This\n+step records ownership only; identity behavior is implemented in step 1.\ndiff --git a/services/metering-billing/README.md b/services/metering-billing/README.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..ec88c610bb35925e514a01018d6e7f1c3ffa6b4b\n--- /dev/null\n+++ b/services/metering-billing/README.md\n@@ -0,0 +1,5 @@\n+# metering-billing\n+\n+Owns provider capability ports, normalized events, reservations, entitlement,\n+and the append-only ledger. Provider adapters are added in step 2; domain code\n+does not import provider SDKs.\ndiff --git a/services/observability/README.md b/services/observability/README.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..2713624b08befeded55ebcd2a59e10ad47efcf60\n--- /dev/null\n+++ b/services/observability/README.md\n@@ -0,0 +1,4 @@\n+# observability\n+\n+Owns redacted correlation and evaluation records. Telemetry must never become\n+the source of truth for entitlement or durable run state.\ndiff --git a/services/project-service/README.md b/services/project-service/README.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..c50724e884d9373e1940dd1c9c3c33c732743fd9\n--- /dev/null\n+++ b/services/project-service/README.md\n@@ -0,0 +1,4 @@\n+# project-service\n+\n+Owns tenant-scoped AI project metadata and references to provider\n+configuration. Secret values never belong in project contracts.\ndiff --git a/services/run-service/README.md b/services/run-service/README.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..c29cf70c3127f9d5d31e0d2f9dcac93407b56136\n--- /dev/null\n+++ b/services/run-service/README.md\n@@ -0,0 +1,4 @@\n+# run-service\n+\n+Owns run state, idempotency, replay sequence, and run events. Durable lifecycle\n+behavior is implemented after the baseline contracts step.\ndiff --git a/tests/test_foundation.py b/tests/test_foundation.py\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..1136b4456bb90f350bcead5a27ddb2b238b6584a\n--- /dev/null\n+++ b/tests/test_foundation.py\n@@ -0,0 +1,61 @@\n+from __future__ import annotations\n+\n+import unittest\n+\n+from foundation.config import ConfigError, validate_profile\n+from foundation.contract_check import check_contracts, validate_against_schema\n+\n+\n+def valid_free() -> dict[str, str]:\n+    return {\n+        \"APP_ENV\": \"local\",\n+        \"DEPLOYMENT_PROFILE\": \"free-portfolio\",\n+        \"APP_BASE_URL\": \"http://localhost:8080\",\n+        \"DATABASE_URL\": \"postgresql://foundation@localhost:5432/foundation\",\n+        \"APP_SECRET_KEY\": \"x\" * 64,\n+        \"CONTRACT_VERSION\": \"v1\",\n+        \"PAYMENT_PROVIDER\": \"mock\",\n+        \"MOCK_PAYMENTS_ENABLED\": \"true\",\n+        \"WORKFLOW_PROVIDER\": \"local\",\n+        \"PAID_INFRASTRUCTURE\": \"false\",\n+        \"AWS_WORKER_ENABLED\": \"false\",\n+    }\n+\n+\n+class ConfigurationTests(unittest.TestCase):\n+    def test_free_profile_accepts_safe_local_values(self) -> None:\n+        config = validate_profile(valid_free())\n+        self.assertEqual(config.deployment_profile, \"free-portfolio\")\n+        self.assertNotIn(\"APP_SECRET_KEY\", config.values)\n+\n+    def test_missing_secret_fails_closed(self) -> None:\n+        values = valid_free()\n+        values.pop(\"APP_SECRET_KEY\")\n+        with self.assertRaises(ConfigError):\n+            validate_profile(values)\n+\n+    def test_paid_resource_fails_closed(self) -> None:\n+        values = {**valid_free(), \"REDIS_URL\": \"redis://paid\"}\n+        with self.assertRaises(ConfigError):\n+            validate_profile(values)\n+\n+    def test_explicit_worker_off_flag_is_safe(self) -> None:\n+        values = {**valid_free(), \"AWS_ALWAYS_ON\": \"false\"}\n+        validate_profile(values)\n+\n+\n+class ContractTests(unittest.TestCase):\n+    def test_contract_inventory_is_deterministic(self) -> None:\n+        self.assertEqual(\n+            check_contracts(),\n+            [\"validated 9 versioned JSON contracts\", \"validated provider registry\"],\n+        )\n+\n+    def test_schema_rejects_unknown_fields(self) -> None:\n+        schema = {\"type\": \"object\", \"additionalProperties\": False, \"properties\": {\"id\": {\"type\": \"string\"}}}\n+        with self.assertRaises(AssertionError):\n+            validate_against_schema({\"unexpected\": True}, schema)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\nhook: Stop\nhook: Stop\nhook: Stop\nhook: Stop\nhook: Stop Completed\nhook: Stop Completed\nhook: Stop Completed\nhook: Stop Completed\ntokens used\n169,896\n",
