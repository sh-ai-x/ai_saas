# Google OAuth sandbox/local integration. Replace every placeholder before use.
APP_ENV=staging
DEPLOYMENT_PROFILE=free-portfolio
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://foundation@localhost:5432/foundation
APP_SECRET_KEY=replace-with-a-random-value-at-least-32-characters
CONTRACT_VERSION=v1
PAYMENT_PROVIDER=mock
MOCK_PAYMENTS_ENABLED=true
PAYMENT_SANDBOX=true
AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
AGENT_PROVIDER=local
AGENT_MODEL=local-echo
AGENT_MAX_OUTPUT_TOKENS=512
AGENT_TIMEOUT_SECONDS=30
WORKFLOW_PROVIDER=local
PAID_INFRASTRUCTURE=false
AWS_WORKER_ENABLED=false
VERCEL_PLAN=free
CLOUDFLARE_PLAN=free
