# Safe identifiers only. Credentials are intentionally not part of this file;
# the optional worker uses an AWS task role and requires a separate cost gate.
APP_ENV=staging
DEPLOYMENT_PROFILE=aws-worker
APP_BASE_URL=https://example.invalid
DATABASE_URL=postgresql://foundation@database.invalid:5432/foundation
APP_SECRET_KEY=
CONTRACT_VERSION=v1
PAYMENT_PROVIDER=mock
MOCK_PAYMENTS_ENABLED=true
WORKFLOW_PROVIDER=local
PAID_INFRASTRUCTURE=false
AWS_WORKER_ENABLED=true
AWS_AUTH_MODE=task-role
AWS_REGION=
AWS_CLUSTER_ARN=
AWS_TASK_DEFINITION=
AWS_SUBNET_ID=
AWS_SECURITY_GROUP_ID=
AWS_WORKER_CAPACITY=fargate-spot
AWS_WORKER_ARCH=arm64
AWS_WORKER_VCPU=0.25
AWS_WORKER_MEMORY_MB=512
AWS_PUBLIC_SUBNET=true
AWS_INBOUND_RULES=none
RUN_QUOTA_MAX_RUNS=50
RUN_QUOTA_MAX_UNITS=500
RUN_QUOTA_PERIOD_SECONDS=86400
OTEL_ENABLED=true
OTEL_SAMPLE_RATE=0.1
OTEL_EXPORTER=memory
