# Toss Payments sandbox. Use test_* credentials from the Toss dashboard.
APP_ENV=staging
DEPLOYMENT_PROFILE=free-portfolio
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://foundation@localhost:5432/foundation
APP_SECRET_KEY=replace-with-a-random-value-at-least-32-characters
CONTRACT_VERSION=v1
PAYMENT_PROVIDER=toss
MOCK_PAYMENTS_ENABLED=false
PAYMENT_SANDBOX=true
TOSS_CLIENT_KEY=test_gck_replace
TOSS_SECRET_KEY=test_sk_replace
TOSS_WEBHOOK_SECRET=replace-toss-webhook-secret
TOSS_CHECKOUT_URL=https://js.tosspayments.com/v2/standard
AUTH_PROVIDER=local-mock
AGENT_PROVIDER=local
AGENT_MODEL=local-echo
AGENT_MAX_OUTPUT_TOKENS=512
AGENT_TIMEOUT_SECONDS=30
WORKFLOW_PROVIDER=local
PAID_INFRASTRUCTURE=false
AWS_WORKER_ENABLED=false
VERCEL_PLAN=free
CLOUDFLARE_PLAN=free
