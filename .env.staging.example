# Staging target — used by `pnpm docker:neon` and `pnpm db:verify:stage` /
# `db:plan:stage` / `db:migrate:stage`. Copy to `.env.staging` (gitignored) and
# fill every placeholder. APP_ENV=staging is required by the migration gate;
# the preflight script enforces it.
APP_ENV=staging
WEB_APP_ENV=staging
NEON_BRANCH=stage2

# Neon pooled URL for runtime traffic; UNPOOLED for Drizzle migrations. Both
# must be TLS Neon URLs (sslmode=require). The preflight rejects non-Neon hosts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required for the Foundation API. Generate with:
#   openssl rand -base64 32
APP_SECRET_KEY=

# Better Auth and Google OAuth. OAuth secrets are server-only.
BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Payments — use the Toss sandbox only. Never put live Toss credentials here.
PAYMENT_PROVIDER=toss
WEB_PAYMENT_PROVIDER=toss
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SDK_SANDBOX_RESULT=SUCCESS
TOSS_WEBHOOK_SECRET=
TOSS_API_BASE_URL=https://api.tosspayments.com
TOSS_SUCCESS_URL=http://localhost:3200/payments/toss/success
TOSS_BILLING_SUCCESS_URL=http://localhost:3200/payments/toss/billing-success
TOSS_FAIL_URL=http://localhost:3200/payments/toss/fail

# LLM provider for the agent runtime. OPENAI_API_KEY is required unless
# AGENT_PROVIDER_MODE=langchain + LANGSMITH_* are set.
OPENAI_API_KEY=
AGENT_PROVIDER_MODE=langchain

# LangSmith observability for LangGraph and nested LangChain runs.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=proposal-to-verified-change
LANGSMITH_CONSOLE_URL=https://smith.langchain.com

# docker:neon derives a separate host-port block per worktree (3200/8280 base).
# Set NEON_DOCKER_SLOT only when a deterministic slot is needed; shell vars
# override the derived slot for one run.
NEON_DOCKER_SLOT=
