# Required for the Foundation API. Generate with:
# openssl rand -base64 32
APP_SECRET_KEY=

# Local Compose defaults. Use a strong value outside local development.
POSTGRES_PASSWORD=foundation-local-only
WEB_DATABASE_URL=postgresql://foundation:foundation-local-only@postgres:5432/foundation

# Keep the local container profile provider-free by default. The browser has
# no local/mock login fallback; configure Google OAuth for account access.
WEB_APP_ENV=local
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
WEB_PAYMENT_PROVIDER=mock

# Live Google OAuth / payment values remain optional and server-only.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=
# LEMONSQUEEZY_API_KEY=
