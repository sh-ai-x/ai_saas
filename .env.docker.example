# Required for the Foundation API. Generate with:
# openssl rand -base64 32
APP_SECRET_KEY=

# Docker-only host ports. `pnpm docker:local` derives a collision-checked block
# per Git worktree. Set DOCKER_LOCAL_SLOT (0-39) when you need a stable manual
# slot; shell assignments override the derived values for one run.
DOCKER_LOCAL_SLOT=
POSTGRES_PORT=55433
FOUNDATION_PORT=8180
WEB_PORT=3100
FOUNDATION_PUBLIC_URL=http://localhost:8180
WEB_PUBLIC_URL=http://localhost:3100

# Local repository picker: docker:local mounts this host directory read-only
# into foundation. Leave blank to mount the current worktree automatically.
LOCAL_REPOSITORY_HOST_ROOT=
LOCAL_REPOSITORY_CONTAINER_ROOT=
LOCAL_REPOSITORY_ROOTS=/local-repositories
LOCAL_REPOSITORY_GIT_COMMON_ROOT=

# Local Compose PostgreSQL uses trust authentication; no password is required.
WEB_DATABASE_URL=postgresql://foundation@postgres:5432/foundation
# Neon uses a direct/unpooled URL for Drizzle migrations. Local Docker keeps
# this equal to WEB_DATABASE_URL; remote use must provide both explicitly.
WEB_DATABASE_URL_UNPOOLED=postgresql://foundation@postgres:5432/foundation
ALLOW_REMOTE_DATABASE=false

# The browser has no local/mock login fallback. Fill the Google values below
# for a real login; without them the login page shows the setup guide.
WEB_APP_ENV=local
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
WEB_PAYMENT_PROVIDER=mock
PAYMENT_SANDBOX=true

# Google OAuth values are server-only except for the enabled flag.
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SDK_SANDBOX_RESULT=SUCCESS
TOSS_WEBHOOK_SECRET=
TOSS_API_BASE_URL=https://api.tosspayments.com
TOSS_SUCCESS_URL=http://localhost:3000/payments/toss/success
TOSS_BILLING_SUCCESS_URL=http://localhost:3000/payments/toss/billing-success
TOSS_FAIL_URL=http://localhost:3000/payments/toss/fail
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=
# LEMONSQUEEZY_API_KEY=
