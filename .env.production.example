# Production target — used ONLY by `pnpm db:migrate:prod` (CI), never by a
# local Compose run. Production secrets come from CI secrets in practice;
# this template exists so the operator can run the release locally if a
# review board requires it. Copy to `.env.production` (gitignored) and fill
# every placeholder.
APP_ENV=production
WEB_APP_ENV=production
NEON_BRANCH=production

# Neon pooled URL for runtime traffic; UNPOOLED for Drizzle migrations. Both
# must be TLS Neon URLs (sslmode=require). The preflight rejects non-Neon hosts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required for the Foundation API. Generate with:
#   openssl rand -base64 32
APP_SECRET_KEY=

# Better Auth and Google OAuth. OAuth secrets are server-only.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Payments — live credentials only. PASTE-WITH-CARE.
PAYMENT_PROVIDER=toss
WEB_PAYMENT_PROVIDER=toss
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
TOSS_API_BASE_URL=https://api.tosspayments.com
TOSS_SUCCESS_URL=
TOSS_BILLING_SUCCESS_URL=
TOSS_FAIL_URL=

# LLM provider for the agent runtime.
OPENAI_API_KEY=
AGENT_PROVIDER_MODE=langchain

# LangSmith observability for LangGraph and nested LangChain runs.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=
LANGSMITH_CONSOLE_URL=https://smith.langchain.com
