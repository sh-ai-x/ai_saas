FOUNDATION_API_URL=http://127.0.0.1:8080
# Use APP_ENV=staging for a real Google OAuth test, even on localhost. The
# browser has no local or mock login fallback. Fill the Google values below.
APP_ENV=local
# Omit DATABASE_URL only for local/test contract work; live Google auth uses Neon.
DATABASE_URL=
PAYMENT_PROVIDER=mock
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
# Must match the browser origin exactly; use a separate value per environment.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sandbox-only provider values. Secrets must stay in the runtime environment.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_API_KEY=
