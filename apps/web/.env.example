FOUNDATION_API_URL=http://127.0.0.1:8080
# Use APP_ENV=staging for a real Google OAuth test, even on localhost. This
# disables the credential-free local admin bypass.
APP_ENV=local
# Omit DATABASE_URL only for the explicit local seed fallback.
DATABASE_URL=
ALLOW_LOCAL_ADMIN=true
PAYMENT_PROVIDER=mock
APP_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Must match the browser origin exactly; use a separate value per environment.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sandbox-only provider values. Secrets must stay in the runtime environment.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_API_KEY=
