{
  "name": "ai-saas-foundation-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "lint": "tsc --noEmit",
    "test": "jest --config jest.config.mjs --runInBand",
    "test:watch": "jest --config jest.config.mjs --watch",
    "test:all": "pnpm lint && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "better-auth": "^1.6.27",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.25",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.2",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
