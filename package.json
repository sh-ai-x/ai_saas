{
  "name": "ai-saas-foundation",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "web:dev": "pnpm --filter ai-saas-foundation-web dev",
    "web:build": "pnpm --filter ai-saas-foundation-web build",
    "web:test": "pnpm --filter ai-saas-foundation-web test:all",
    "web:e2e": "pnpm --filter ai-saas-foundation-web exec jest --config jest.e2e.config.mjs --runInBand",
    "docker:local": "bash scripts/docker-local.sh",
    "docker:local:down": "bash scripts/docker-local.sh down",
    "docker:local:purge": "bash scripts/docker-local.sh down --volumes",
    "docker:neon": "bash scripts/docker-neon.sh",
    "docker:neon:down": "bash scripts/docker-neon.sh down",
    "web:setup-auth": "uv run --locked python scripts/setup-web-auth.py",
    "web:db:generate": "pnpm --filter ai-saas-foundation-web db:generate",
    "web:db:migrate": "pnpm --filter ai-saas-foundation-web db:migrate",
    "db:verify:stage": "node scripts/migration-preflight.mjs --target staging",
    "db:verify:prod": "node scripts/migration-preflight.mjs --target production",
    "db:plan:stage": "node scripts/migration-release.mjs --target staging --plan",
    "db:plan:prod": "node scripts/migration-release.mjs --target production --plan",
    "db:migrate:stage": "node scripts/migration-release.mjs --target staging --apply",
    "db:migrate:prod": "node scripts/migration-release.mjs --target production --apply",
    "db:repair-history:stage": "node scripts/migration-history-repair.mjs --target staging",
    "db:cleanup:legacy:stage": "node scripts/migration-history-repair.mjs --target staging --cleanup-legacy"
  },
  "devDependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3"
  }
}
