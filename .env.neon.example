# Copy to .env.neon and keep the copy uncommitted.
# DATABASE_URL is the pooled Neon URL for runtime traffic.
DATABASE_URL=
# DATABASE_URL_UNPOOLED is the direct Neon URL for Drizzle migrations.
DATABASE_URL_UNPOOLED=

APP_SECRET_KEY=
BETTER_AUTH_SECRET=
APP_ENV=staging
WEB_APP_ENV=staging
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYMENT_PROVIDER=mock
WEB_PAYMENT_PROVIDER=mock

# docker:neon derives a separate port block per worktree from a hash of the
# branch name when this is unset. Pin it to 0 for a predictable
# http://localhost:3200 in every clone.
NEON_DOCKER_SLOT=0
