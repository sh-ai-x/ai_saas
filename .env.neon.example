# Copy to .env.neon and keep the copy uncommitted.
# DATABASE_URL is the pooled Neon URL for runtime traffic.
DATABASE_URL=
# DATABASE_URL_UNPOOLED is the direct Neon URL for Drizzle migrations.
DATABASE_URL_UNPOOLED=

APP_SECRET_KEY=
BETTER_AUTH_SECRET=
APP_ENV=staging
WEB_APP_ENV=staging
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYMENT_PROVIDER=mock
WEB_PAYMENT_PROVIDER=mock

# docker:neon derives a separate block per worktree. Set this only when a
# deterministic slot is needed; shell variables override the derived slot.
NEON_DOCKER_SLOT=
